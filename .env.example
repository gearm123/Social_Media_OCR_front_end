# Copy to .env and adjust. No trailing slash.
# Local FastAPI: VITE_API_BASE_URL=http://127.0.0.1:8000
# Netlify/production: use https://... (HTTPS required if the site is HTTPS — mixed content blocks http:// APIs).
VITE_API_BASE_URL=https://translate-chat-backend.onrender.com

# Paddle.js (client-side token from Paddle Dashboard → Developer tools). Required for /pay checkout page.
# production | sandbox — must match your Paddle API mode on the backend.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=production
