# =============================================================================
# Local development (copy to `.env` — gitignored — then `npm run dev`)
# =============================================================================
# Point at your machine’s FastAPI. No trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Paddle.js — client-side token from Paddle → Developer tools (same account as backend keys).
# Required for the /pay checkout page.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=production

# Show debug ($0.70) plan in Plans modal. Set to false for production builds.
# VITE_SHOW_DEBUG_PRICE=false

# Optional: POST /jobs timeout (upload + intake). Default 600000 (10 min). Raise for huge images / slow networks.
# VITE_CREATE_JOB_TIMEOUT_MS=900000

# =============================================================================
# Production (Netlify / etc.): use HTTPS API URL and redeploy after changes.
# =============================================================================
# VITE_API_BASE_URL=https://translate-chat-backend.onrender.com
#
# Public site URL (no trailing slash). Enables canonical URLs, og:url, sitemap.xml, and robots.txt Sitemap line.
# VITE_SITE_URL=https://socialmessageocr.netlify.app
